#!/usr/bin/env bash
# Start the app from this folder:  ./snagit
#
# Builds on first run so a fresh clone works without a separate step.
set -euo pipefail
cd "$(dirname "$0")"

if [ "$(uname -s)" != "Darwin" ]; then
  echo "snagit runs on macOS only." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "node isn't installed. Get Node 22 or newer: brew install node" >&2
  exit 1
fi

major=$(node -p 'process.versions.node.split(".")[0]')
if [ "$major" -lt 22 ]; then
  echo "Node $major found, but 22 or newer is needed. Try: brew upgrade node" >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "Installing dependencies (first run only) …"
  npm install --silent
fi

# Rebuild when the sources are newer than the build, so edits take effect.
if [ ! -f dist/cli.js ] || [ -n "$(find source -newer dist/cli.js -type f -print -quit 2>/dev/null)" ]; then
  echo "Building …"
  npm run build --silent
fi

exec node dist/cli.js "$@"
